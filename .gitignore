*.pdf
*.png
/RS_proposal_draft_v1_overthinking_archived.md

# Python / uv
.venv/
__pycache__/
*.pyc

# uv.lock is intentionally NOT ignored: it pins the exact dependency graph and
# is what makes the experiments reproducible.

# Experiment outputs
results/**/*.pt
results/**/*.safetensors

# The paper is a deliverable, so its built PDF and figures are tracked despite
# the blanket *.pdf / *.png rules at the top of this file.
!paper/main.pdf
!paper/figures/*.pdf

# LaTeX build litter. Everything here is regenerated by `pdflatex; bibtex`.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/missfont.log

# The demo page is a deliverable and is generated by demo/build_demo.py.
!demo/index.html
